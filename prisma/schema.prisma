generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Teacher {
  id       String   @id @default(uuid())
  name     String
  avatar   String   @default("/images/person.webp")
  bio      String   @db.Text
  students Int      @default(0)
  courses  Int      @default(0)
  rating   Float    @default(0)
  Course   Course[]
}

model Course {
  id              String     @id @default(uuid())
  imageUrl        String
  title           String
  price           Int
  rate            Float      @default(0)
  lesson          Int        @default(0)
  members         Int        @default(0)
  duration        Int        @default(0)
  discount        Int        @default(0)
  description     String?    @db.Text
  fullDescription String?    @db.Text
  prerequisites   String?    @db.Text
  language        String     @default("فارسی")
  createdAt       DateTime   @default(now())
  teacherId       String
  teacher         Teacher    @relation(fields: [teacherId], references: [id])
  chapters        Chapter[]
  reviews         Review[]
  wishlists       Wishlist[]
  cartItems       CartItem[]
  payments        Payment[]

  @@index([teacherId])
}

model Chapter {
  id       String   @id @default(uuid())
  title    String
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id        String  @id @default(uuid())
  title     String
  duration  String?
  videoUrl  String? @db.Text
  posterUrl String? @db.Text
  isLock    Boolean @default(false)
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  userProgresses UserProgress[]

  @@index([chapterId])
}

model UserProgress {
  id     String @id @default(uuid())
  userId String @db.VarChar(100)

  lessonId String @db.VarChar(100)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  isComplated Boolean @default(false)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Review {
  id       String @id @default(uuid())
  name     String
  rating   Int
  date     String
  comment  String @db.Text
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @db.VarChar(100)
  courseId  String   @db.VarChar(100)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @db.VarChar(100)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  courseId  String   @db.VarChar(100)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cartId, courseId])
  @@index([cartId])
  @@index([courseId])
}

model Payment {
  id String @id @default(uuid())

  userId String @db.VarChar(100)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  amount Int

  // شناسه مشترک ردیف‌های یک سفارش (سبد می‌تواند چند دوره داشته باشد و زرین‌پال
  // در هر تراکنش فقط یک authority می‌دهد)
  orderId String?

  authority String?
  refId     String?

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([orderId])
  @@index([authority])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
