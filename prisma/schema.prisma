generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  userId    String  @id
  email     String  @unique
  username  String
  password  String
  firstName String?
  lastName  String?
  role      Role    @default(USER)
}

enum Role {
  USER
  ADMIN
}
